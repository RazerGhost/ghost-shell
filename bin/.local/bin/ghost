#!/usr/bin/env bash
# ghost: this machine's setup from the Ghost Shell repo, in one command. Linked into ~/.local/bin by
# stow (the bin/ package); install.sh runs it from the repo on the first run.
#
#   ghost install [module...] [--machine <name>] [--theme <wallpaper | "#rrggbb">] [--yes]
#                     packages and setup for the modules (default: this machine's, see below).
#                     --machine: a profile from machines/ (laptop, desktop) becomes this machine's
#                     module list first. --yes: no questions from pacman and paru (paru then skips
#                     showing the PKGBUILDs). sudo's password is asked once and kept for the run.
#   ghost update      pull the repo, then install again
#   ghost theme <wallpaper | "#rrggbb">
#                     the wallpaper and the colors from it (the same as the shell's picker)
#   ghost webapp add <name> <url> [icon] | remove <name> | list
#                     a site in its own window, in the launcher and the dock (modules/apps/webapp.sh)
#   ghost calendar add [name] | remove <name> | list | sync
#                     a subscribed calendar (Google's secret iCal address, any .ics link) in the today menu
#                     (modules/calendar/calendar.sh)
#   ghost wallpapers get [--style sky|lofi|painterly|minimal] [search words] [--count N] [--general]
#                     art from wallhaven.cc (anime by default, safe for work only) into your
#                     wallpaper folder (modules/core/wallpapers.sh)
#   ghost wallpapers fetch <id>
#                     one picture by its wallhaven id (the shell's Wallpapers window uses it)
#   ghost looks export | import
#                     your themes and looks into the repo's looks.json, or from it into this
#                     machine's (modules/core/looks.sh)
#   ghost migrate     the one-time changes for machines set up by an earlier version (migrations/;
#                     also run at the end of every install and update)
#   ghost doctor      check that everything is set up
#   ghost modules     list the modules, and which this machine uses
#   ghost keybinds    Hyprland's keybinds as a Markdown table (docs/keybinds.md is made with it)
#
# Modules are the folders in modules/: their packages (packages.txt, aur.txt; packages.sh prints
# the ones that depend on the hardware) and setup (setup.sh). Which ones this machine gets: ~/.config/ghost/modules, one name per line (not in
# the repo, so each machine has its own; machines/ has the profiles to start from); without that
# file, all of them but the opt-in ones (hardware plugged into one machine, like wave3).
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)
cd "$repo"
. modules/lib.sh

# In the order they're set up: core first (configs, colors), the apps after it.
all_modules=(core system snapshots apps dev gaming discord spotify zen haunt capture phone proton calendar llm claude wave3)
# Only for machines that list them in ~/.config/ghost/modules, never part of "all": hardware
# that's plugged into one machine.
opt_in=(llm claude wave3)
declare -A about=(
    [core]="Hyprland, the shell, fonts and themes, the colors"
    [system]="GPU links, hardware fixes for this machine, boot options, logging in at boot (greetd) and services (sudo)"
    [snapshots]="Btrfs snapshots: the system's at every update, your home hourly (sudo)"
    [apps]="terminal, editor, files, pictures, video, music, browser, web apps"
    [dev]="languages, package managers and Docker"
    [gaming]="Steam, Proton, Lutris, Heroic, MangoHud; Millennium's theme"
    [discord]="Vesktop with Vencord and the Ghost plugin"
    [spotify]="Spotify with Spicetify and the Ghost theme"
    [zen]="Zen in the wallpaper's colors"
    [haunt]="the Haunt Git client (its release package) and what building it needs"
    [capture]="screen recording, color picker, text and QR codes from the screen"
    [phone]="KDE Connect and LocalSend: your phone's notifications, clipboard and files; files to any device nearby"
    [proton]="Proton Mail, Pass and VPN"
    [calendar]="calendar events in the today menu, from a calendar's iCal link (Google's secret address)"
    [llm]="local coding LLM on the NVIDIA GPU: Ollama, OpenCode, Aider (only where it has the GPU)"
    [claude]="Claude Code, Anthropic's coding agent in the terminal (only where you want it)"
    [wave3]="the Elgato Wave:3 with openxlr and a voice chain (only where it's plugged in)"
)
machine_modules="$HOME/.config/ghost/modules"

# Lines of a list file without comments and blank lines (nothing if it doesn't exist).
entries() {
    [[ -f $1 ]] || return 0
    grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$1" | sed 's/[[:space:]]*$//'
}

# This machine's modules, in setup order: the ones ~/.config/ghost/modules lists, or without
# that file every module but the opt-in ones.
machine() {
    local m
    if [[ -f $machine_modules ]]; then
        local chosen
        chosen=$(entries "$machine_modules")
        for m in "${all_modules[@]}"; do
            grep -qx "$m" <<<"$chosen" && echo "$m"
        done
    else
        for m in "${all_modules[@]}"; do
            [[ " ${opt_in[*]} " == *" $m "* ]] || echo "$m"
        done
    fi
}

# A module's pacman packages: its packages.txt, and what its packages.sh prints for this machine's
# hardware (the system module's NVIDIA packages).
module_packages() {
    entries "modules/$1/packages.txt"
    if [[ -x modules/$1/packages.sh ]]; then
        "modules/$1/packages.sh"
    fi
}

is_module() {
    [[ -n ${about[$1]+set} ]]
}

# sudo's password once for the whole run: a long AUR build outlasts sudo's few minutes, and it
# asked again halfway through. Refreshed in the background until this script ends.
keep_sudo() {
    sudo -v || fail "sudo is needed to install packages"
    local parent=$$
    # Its output closed, so `ghost install | tee log` doesn't wait for its last sleep.
    ( while kill -0 "$parent" 2>/dev/null; do sudo -n -v 2>/dev/null; sleep 50; done ) >/dev/null 2>&1 &
}

cmd_install() {
    local theme=() wanted=() m yes=0
    while (($#)); do
        case $1 in
            --theme) theme=("${2:?--theme needs a wallpaper or a \"#rrggbb\" color}"); shift 2 ;;
            --yes) yes=1; shift ;;
            --machine)
                local profile=machines/${2:?--machine needs a name: $(ls machines | tr '\n' ' ')}
                [[ -f $profile && $2 != */* ]] || fail "no machine profile \"$2\" (machines/ has: $(ls machines | tr '\n' ' '))"
                mkdir -p "$(dirname "$machine_modules")"
                cp "$profile" "$machine_modules"
                echo "This machine's modules: $profile (now $machine_modules; edit it there)"
                shift 2 ;;
            *) is_module "$1" || fail "no module \"$1\" (ghost modules lists them)"; wanted+=("$1"); shift ;;
        esac
    done
    local modules=()
    if ((${#wanted[@]})); then
        # In setup order, whatever order they were named in.
        for m in "${all_modules[@]}"; do
            printf '%s\n' "${wanted[@]}" | grep -x "$m" >/dev/null && modules+=("$m")
        done
    else
        mapfile -t modules < <(machine)
    fi
    echo "Modules: ${modules[*]}"
    keep_sudo
    local confirm=() confirm_aur=()
    if ((yes)); then
        confirm=(--noconfirm)
        confirm_aur=(--noconfirm --skipreview)
    fi

    step "Packages"
    local pacman_pkgs=() aur_pkgs=()
    for m in "${modules[@]}"; do
        mapfile -t -O "${#pacman_pkgs[@]}" pacman_pkgs < <(module_packages "$m")
        mapfile -t -O "${#aur_pkgs[@]}" aur_pkgs < <(entries "modules/$m/aur.txt")
    done
    # As arguments, not on stdin: pacman and paru read their "Proceed?" answers from stdin.
    # Several modules may list the same package; --needed skips what's installed.
    if ((${#pacman_pkgs[@]})); then
        mapfile -t pacman_pkgs < <(printf '%s\n' "${pacman_pkgs[@]}" | sort -u)
        sudo pacman -S --needed "${confirm[@]}" "${pacman_pkgs[@]}"
    fi
    if ((${#aur_pkgs[@]})); then
        # rustup installs no toolchain by itself; some AUR packages build with Rust (millennium).
        if command -v rustup >/dev/null && ! rustup toolchain list | grep stable >/dev/null; then
            rustup default stable
        fi
        mapfile -t aur_pkgs < <(printf '%s\n' "${aur_pkgs[@]}" | sort -u)
        # Built from source (user's choice over -bin packages), then cleaned up: the build-only
        # dependencies removed and the build folders deleted.
        paru -S --needed --removemake --cleanafter "${confirm_aur[@]}" "${aur_pkgs[@]}"
    fi

    # Every module's setup, through bash (a setup.sh committed without its executable bit was
    # skipped without a word: the dev module's, until 2026-11-05). One that fails doesn't stop the
    # others: they're listed at the end and the install fails then (a missing Wave:3 used to end
    # the desktop's first install before its last steps).
    local failed_modules=()
    for m in "${modules[@]}"; do
        [[ -f modules/$m/setup.sh ]] || continue
        if [[ $m == core ]]; then
            bash "modules/$m/setup.sh" "${theme[@]}" || failed_modules+=("$m")
        else
            bash "modules/$m/setup.sh" || failed_modules+=("$m")
        fi
    done
    if [[ ${#theme[@]} -gt 0 && ! " ${modules[*]} " =~ " core " ]]; then
        cmd_theme "${theme[@]}"
    fi
    cmd_migrate
    if ((${#failed_modules[@]})); then
        fail "these modules' setup failed (their messages are above): ${failed_modules[*]}; fix it and run ghost install ${failed_modules[*]}"
    fi

    step "Done"
    echo "Log out and back in if this was the first run or env.lua changed (GPU settings apply at Hyprland start)."
}

cmd_update() {
    # Not with uncommitted changes: pulling would need a stash, and stashing takes files like
    # hyprland.lua away from the running desktop for a moment.
    if [[ -n $(git status --porcelain) ]]; then
        fail "the repo has uncommitted changes; commit them first (git status shows them)"
    fi
    step "Pulling the repo"
    git pull --rebase
    # The new version of this script does the rest.
    exec "$repo/bin/.local/bin/ghost" install "$@"
}

# Runs the migrations this machine hasn't run yet (migrations/README.md), in name order, each
# recorded once it succeeds; a failing one stops the run and stays for next time.
cmd_migrate() {
    local done_list=${XDG_STATE_HOME:-$HOME/.local/state}/ghost/migrations migration name
    mkdir -p "$(dirname "$done_list")"
    touch "$done_list"
    for migration in migrations/*.sh; do
        name=$(basename "$migration" .sh)
        grep -qx "$name" "$done_list" && continue
        step "Migration: $name"
        bash -c 'set -euo pipefail; . modules/lib.sh; . "$1"' migration "$migration" \
            || fail "migration $name failed; fix it and run ghost migrate again"
        echo "$name" >>"$done_list"
    done
}

cmd_theme() {
    (($#)) || fail "ghost theme needs a wallpaper or a \"#rrggbb\" color"
    sh matugen/.config/matugen/wallpaper.sh "$1"
}

cmd_modules() {
    local chosen m mark
    chosen=$(machine)
    if [[ -f $machine_modules ]]; then
        echo "This machine's modules come from $machine_modules (* = used):"
    else
        echo "No $machine_modules: this machine uses all but the opt-in ones (* = used):"
    fi
    for m in "${all_modules[@]}"; do
        mark=" "
        grep -qx "$m" <<<"$chosen" && mark="*"
        printf '  %s %-9s %s\n' "$mark" "$m" "${about[$m]}"
    done
}

cmd_doctor() {
    local failed=0 pkg missing m
    ok() { printf '  \033[1;32m✓\033[0m %s\n' "$1"; }
    bad() { printf '  \033[1;31m✗\033[0m %s\n' "$1"; failed=1; }

    step "Hardware (ghost-hw facts)"
    hw facts | sed 's/^/  /'

    step "Configs linked into your home folder"
    for pkg in $(stow_packages); do
        # In simulation, stow prints nothing but its notice when everything is linked already.
        # shellcheck disable=SC2046 # no flag or one
        if stow -n -v $(stow_flags "$pkg") -t "$HOME" "$pkg" 2>&1 | grep -v "in simulation mode" >/dev/null; then
            bad "$pkg: not linked or in conflict (ghost install core links it)"
        else
            ok "$pkg"
        fi
    done

    step "Packages of this machine's modules"
    for m in $(machine); do
        missing=$({ module_packages "$m"; entries "modules/$m/aur.txt"; } | xargs -r pacman -T || true)
        if [[ -n $missing ]]; then
            bad "$m: missing $(echo $missing) (ghost install $m)"
        else
            ok "$m"
        fi
    done

    step "Desktop"
    if pgrep -x Hyprland >/dev/null; then
        if [[ -z $(hyprctl configerrors 2>/dev/null | grep -v '^$') ]]; then ok "Hyprland config loads without errors"
        else bad "Hyprland reports config errors (hyprctl configerrors)"; fi
    else
        ok "Hyprland isn't running here; skipped its config check"
    fi
    if pgrep -x qs >/dev/null; then ok "the shell (Quickshell) is running"
    else bad "the shell isn't running (hypr/shell.sh starts it at login)"; fi
    if systemctl --user is-active --quiet filter-chain.service; then ok "the equalizer is running"
    else bad "the equalizer isn't running (systemctl --user enable --now filter-chain.service)"; fi
    if [[ -f $HOME/.local/state/quickshell/colors.json ]]; then ok "colors generated"
    else bad "no colors yet (ghost theme <wallpaper>)"; fi

    step "Services"
    if machine | grep -x system >/dev/null; then
        for unit in greetd.service NetworkManager.service bluetooth.service power-profiles-daemon.service; do
            if systemctl is-enabled "$unit" >/dev/null 2>&1; then ok "$unit"; else bad "$unit isn't enabled (ghost install system)"; fi
        done
    fi
    if machine | grep -x dev >/dev/null; then
        if systemctl is-enabled docker.socket >/dev/null 2>&1; then ok "docker.socket"; else bad "docker.socket isn't enabled (ghost install dev)"; fi
    fi

    step "Everything the repo uses is declared (tests/deps_test.sh)"
    local deps
    if deps=$(bash tests/deps_test.sh 2>&1); then ok "${deps##*$'\n'}"
    else bad "$(sed 's/^/  /' <<<"$deps" | sed '1s/^  //')"; fi

    step "Committing and pushing from this machine"
    if [[ -n $(git config user.name) && -n $(git config user.email) ]]; then ok "git knows your name and email"
    else bad "git has no name or email (git config --global user.name ...; user.email: GitHub's noreply address keeps yours private)"; fi
    if git ls-remote --exit-code origin HEAD >/dev/null 2>&1 && GIT_TERMINAL_PROMPT=0 git push --dry-run --quiet origin HEAD >/dev/null 2>&1; then
        ok "pushing to GitHub works"
    else
        bad "can't push to GitHub (gh auth login, then gh auth setup-git)"
    fi

    echo
    if ((failed)); then
        echo "Some checks failed; each says what fixes it."
        return 1
    fi
    echo "Everything is set up."
}

# Every bind with a description, by category, as Markdown: the settings window's keybinds page
# in text. The grouping is the page's own (quickshell's settings/Keybinds.js, loaded here).
cmd_keybinds() {
    # Keybinds.js is the settings window's grouping, tested (a QML JavaScript library: js_with).
    hyprctl binds -j | js_with quickshell/.config/quickshell/settings/Keybinds.js '
        for (const group of lib.groups(JSON.parse(fs.readFileSync(0, "utf8")))) {
            console.log(`\n## ${group.category}\n\n| Keys | What it does |\n|---|---|`);
            for (const row of group.rows) {
                const keys = row.combos.map(c => c.map(k => "`" + k + "`").join(" + ")).join(" or ");
                console.log(`| ${keys.replace(/\|/g, "\\|")} | ${row.description} |`);
            }
        }
    '
}

case ${1:-help} in
    install) shift; cmd_install "$@" ;;
    update) shift; cmd_update "$@" ;;
    theme) shift; cmd_theme "$@" ;;
    webapp) shift; modules/apps/webapp.sh "$@" ;;
    calendar) shift; modules/calendar/calendar.sh "$@" ;;
    looks) shift; modules/core/looks.sh "$@" ;;
    wallpapers) shift; modules/core/wallpapers.sh "$@" ;;
    migrate) keep_sudo; cmd_migrate ;;
    doctor) cmd_doctor ;;
    modules) cmd_modules ;;
    keybinds) cmd_keybinds ;;
    help | -h | --help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
    *) fail "unknown command \"$1\" (ghost help lists them)" ;;
esac
