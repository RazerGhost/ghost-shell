// Material colors generated by matugen from the wallpaper.
// `pragma Singleton` + a Singleton root makes this one shared instance: use it as Colors.primary.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    readonly property color primary:          json.primary
    readonly property color onPrimary:        json.on_primary
    readonly property color surface:          json.surface
    readonly property color surfaceContainer: json.surface_container
    readonly property color onSurface:        json.on_surface
    readonly property color onSurfaceVariant: json.on_surface_variant
    readonly property color outlineVariant:   json.outline_variant
    readonly property color error:            json.error

    // Written by matugen (templates/quickshell-colors.json). watchChanges + reload() picks up
    // a new wallpaper's colors live, without restarting the shell.
    FileView {
        path: Quickshell.env("HOME") + "/.local/state/quickshell/colors.json"
        watchChanges: true
        onFileChanged: reload()
        onLoadFailed: console.warn("Colors: can't read " + path + ", using fallback colors. Run matugen once to generate it.")

        // JsonAdapter maps JSON keys to these properties. The defaults are the Material
        // baseline dark scheme, used until the file exists.
        adapter: JsonAdapter {
            id: json
            property string primary:            "#d0bcff"
            property string on_primary:         "#381e72"
            property string surface:            "#141218"
            property string surface_container:  "#211f26"
            property string on_surface:         "#e6e0e9"
            property string on_surface_variant: "#cac4d0"
            property string outline_variant:    "#49454f"
            property string error:              "#f2b8b5"
        }
    }
}
