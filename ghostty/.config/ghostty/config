# Ghostty config: https://ghostty.org/docs/config/reference

# Generated by matugen into ./themes/Matugen (not in git)
theme = Matugen

font-family = MesloLGS Nerd Font

# Space between the text and the window edge (Ghostty's default is almost none)
window-padding-x = 12
window-padding-y = 10
# Spread leftover space (the window rarely fits an exact number of cells) evenly on all sides
window-padding-balance = true

# Draw Ghostty's own title bar (close, maximize, minimize; drag to move). Hyprland draws none,
# and with the default "auto" Ghostty leaves it to the compositor, so there'd be no bar at all.
window-decoration = client

# See-through, like the shell's glass panels: Hyprland blurs what's behind (look.lua).
background-opacity = 0.85
