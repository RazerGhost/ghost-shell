#!/bin/sh
# Nautilus: right-click files -> Scripts -> Send to phone. Sends them to your phone through KDE
# Connect (the phone module) with the shell's phone.sh, which asks which phone when several are
# connected. Nautilus runs it in the folder with the chosen files' names as arguments.
[ $# -gt 0 ] || exit 0
exec "$HOME/.config/quickshell/services/phone.sh" share "$@"
