#!/bin/sh
# Nautilus: right-click files -> Scripts -> Send to phone. Sends them to your phone through KDE
# Connect (the phone module); with several phones connected, asks which. Nautilus runs it in the
# folder with the chosen files' names as arguments.
set -u
[ $# -gt 0 ] || exit 0

phones=$(kdeconnect-cli -a --id-name-only 2>/dev/null)
if [ -z "$phones" ]; then
    notify-send -a "Phone" -i smartphone "No phone connected" "Open KDE Connect on your phone, on the same Wi-Fi."
    exit 0
fi
if [ "$(printf '%s\n' "$phones" | wc -l)" -eq 1 ]; then
    id=${phones%% *}
else
    # zenity's list: an id column (hidden) and a name column.
    id=$(printf '%s\n' "$phones" | while read -r pid name; do printf '%s\n%s\n' "$pid" "$name"; done |
        zenity --list --title="Send to which phone?" --column=id --column=Phone --hide-column=1 --print-column=1) || exit 0
fi

count=0
for file in "$@"; do
    kdeconnect-cli -d "$id" --share "$(realpath -- "$file")" >/dev/null 2>&1 && count=$((count + 1))
done
[ "$count" -eq 1 ] && what="1 file" || what="$count files"
notify-send -a "Phone" -i smartphone "Sent to your phone" "$what"
