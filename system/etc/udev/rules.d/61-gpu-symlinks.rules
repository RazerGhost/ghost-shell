# A stable name for every GPU, by its PCI slot: /dev/dri/gpu-pci-0000_01_00_0. Hyprland's
# AQ_DRM_DEVICES (env.lua, from `ghost-hw drm-devices`) lists them, the display GPU first.
# /dev/dri/cardN numbers can change between boots, and /dev/dri/by-path/ has colons, which the
# colon-separated AQ_DRM_DEVICES can't take; ID_PATH_TAG is the same path without them (set by
# systemd's 60-drm.rules). Until 2026-11-05 the links were named by vendor (amd-igpu,
# nvidia-dgpu), which assumed one card from each.
#
# Installed by the system module (modules/system/setup.sh).
KERNEL=="card*", SUBSYSTEM=="drm", ENV{ID_PATH_TAG}=="pci-*", SYMLINK+="dri/gpu-$env{ID_PATH_TAG}"
